<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dashboardScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ui_page_inset">
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dashboardConnectionCard"
            style="@style/HomeVpn.Ui.Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/ui_vpn_disabled_container"
            app:cardCornerRadius="28dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">
                <FrameLayout
                    android:id="@+id/dashboardConnectionGlyph"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_gravity="center_horizontal"
                    android:importantForAccessibility="noHideDescendants">
                    <ImageView
                        android:id="@+id/dashboardConnectionIcon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="8dp"
                        android:src="@drawable/ui_ic_shield_off"
                        app:tint="@color/ui_vpn_disabled" />
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/dashboardConnectionProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorSize="34dp"
                        app:indicatorInset="0dp"
                        app:trackThickness="4dp"
                        app:trackColor="@android:color/transparent" />
                </FrameLayout>
                <TextView
                    android:id="@+id/dashboardState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    android:text="@string/ui_disabled"
                    android:textColor="@color/ui_vpn_disabled"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium.Emphasized" />
                <TextView
                    android:id="@+id/dashboardSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:accessibilityLiveRegion="polite"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="4"
                    android:minLines="1"
                    android:textColor="@color/ui_vpn_disabled"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:visibility="invisible" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashboardConnect"
                    style="@style/Widget.Material3Expressive.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:minHeight="56dp"
                    android:singleLine="false"
                    android:text="@string/ui_start"
                    app:icon="@drawable/ui_ic_power"
                    app:iconGravity="textStart"
                    app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.Medium" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dashboardProfileCard"
            style="@style/HomeVpn.Ui.Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="8dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/profile_dashboard_label"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ui_text_secondary" />
                    <TextView
                        android:id="@+id/dashboardProfile"
                        android:layout_width="0dp"
                        android:layout_marginTop="0dp"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1.65"
                        android:gravity="end"
                        android:textAlignment="viewEnd"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ui_text_primary" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/ui_server"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ui_text_secondary" />
                    <TextView
                        android:id="@+id/dashboardServer"
                        android:layout_width="0dp"
                        android:layout_marginTop="0dp"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1.65"
                        android:breakStrategy="simple"
                        android:gravity="end"
                        android:textAlignment="viewEnd"
                        android:textIsSelectable="true"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ui_text_primary" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/ui_hub"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ui_text_secondary" />
                    <TextView
                        android:id="@+id/dashboardHub"
                        android:layout_width="0dp"
                        android:layout_marginTop="0dp"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1.65"
                        android:gravity="end"
                        android:textAlignment="viewEnd"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ui_text_primary" />
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="4dp"
                    android:background="@color/ui_outline" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/ui_backend"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ui_text_secondary" />
                    <TextView
                        android:id="@+id/dashboardBackend"
                        android:layout_width="0dp"
                        android:layout_marginTop="0dp"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1.65"
                        android:gravity="end"
                        android:textAlignment="viewEnd"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ui_text_primary" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/dashboardInterfaceRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/vpn_virtual_adapter"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ui_text_secondary" />
                    <TextView
                        android:id="@+id/dashboardInterface"
                        android:layout_width="0dp"
                        android:layout_marginTop="0dp"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1.65"
                        android:gravity="end"
                        android:textAlignment="viewEnd"
                        android:textIsSelectable="true"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ui_text_primary" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/ui_elapsed"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ui_text_secondary" />
                    <TextView
                        android:id="@+id/dashboardElapsed"
                        android:layout_width="0dp"
                        android:layout_marginTop="0dp"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1.65"
                        android:gravity="end"
                        android:textAlignment="viewEnd"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ui_text_primary"
                        android:fontFamily="monospace" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dashboardDetailsCard"
            style="@style/HomeVpn.Ui.Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:text="@string/ui_network_details"
                    android:textColor="@color/ui_text_secondary"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <TextView
                    android:id="@+id/dashboardStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:breakStrategy="simple"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/ui_text_secondary"
                    android:textIsSelectable="true"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
