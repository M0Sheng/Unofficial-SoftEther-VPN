<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/HomeVpn.Preference3.InteractiveSurface"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- DropDownPreference opens this spinner when the visible row is clicked. -->
    <Spinner
        android:id="@+id/spinner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="invisible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <include layout="@layout/preference_material3_content" />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/preference_dropdown_arrow"
            app:tint="@color/ui_text_secondary" />
    </LinearLayout>

</FrameLayout>
