<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ui_background">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <include
            android:id="@+id/pageHeading"
            layout="@layout/view_page_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/ui_page_inset"
                android:paddingEnd="@dimen/ui_page_inset"
                android:paddingBottom="16dp">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/destinationLegacyCard"
                    style="@style/HomeVpn.Ui.Panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="?attr/colorTertiaryContainer"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:id="@+id/destinationLegacyBanner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnTertiaryContainer"
                            android:textAppearance="@style/TextAppearance.Material3.TitleSmall.Emphasized" />
                        <TextView
                            android:id="@+id/destinationLegacyDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textIsSelectable="true"
                            android:textColor="?attr/colorOnTertiaryContainer"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/destinationModes"
                    style="@style/HomeVpn.Ui.RoutingModeGroup">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/destinationModeExclude"
                        style="@style/HomeVpn.Ui.AppRoutingMode"
                        android:text="@string/destination_mode_exclude" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/destinationModeInclude"
                        style="@style/HomeVpn.Ui.AppRoutingMode"
                        android:text="@string/destination_mode_include" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/destinationModeAll"
                        style="@style/HomeVpn.Ui.AppRoutingMode"
                        android:text="@string/destination_mode_all" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
                <TextView
                    android:id="@+id/destinationModeHint"
                    style="@style/HomeVpn.Ui.RoutingModeHint" />
                <TextView
                    android:id="@+id/destinationSupport"
                    style="@style/HomeVpn.Ui.RoutingSupport" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/destinationExcludeBox"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/destination_routing_exclude_label"
                    android:visibility="gone">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/destinationExclude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="6"
                        android:maxLines="14"
                        android:gravity="top|start"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:saveEnabled="false"
                        android:fontFamily="monospace"
                        android:textSize="14sp"
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:minHeight="56dp" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/destinationIncludeBox"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/destination_routing_include_label"
                    android:visibility="gone">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/destinationInclude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="6"
                        android:maxLines="14"
                        android:gravity="top|start"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:saveEnabled="false"
                        android:fontFamily="monospace"
                        android:textSize="14sp"
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:minHeight="56dp" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    android:id="@+id/destinationRetained"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="@string/destination_routing_retained"
                    android:textColor="@color/ui_text_secondary"
                    android:visibility="gone"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:text="@string/destination_routing_rules_help"
                    android:textColor="@color/ui_text_secondary"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
                <TextView
                    android:id="@+id/destinationError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:textColor="?attr/colorError"
                    android:accessibilityLiveRegion="polite"
                    android:visibility="gone"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ui_page_inset"
        android:paddingEnd="@dimen/ui_page_inset"
        android:paddingBottom="12dp"
        android:paddingTop="8dp">
        <TextView
            android:id="@+id/destinationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ui_text_secondary"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/destinationSave"
            style="@style/Widget.Material3Expressive.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="56dp"
            android:singleLine="false"
            android:text="@string/action_save"
            app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.Medium" />
    </LinearLayout>
</LinearLayout>