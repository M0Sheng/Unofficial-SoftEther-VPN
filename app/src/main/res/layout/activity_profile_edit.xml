<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profileEditRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ui_background"
    android:saveEnabled="false">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <include
            android:id="@+id/pageHeading"
            layout="@layout/view_page_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            android:fillViewport="true"
            android:clipToPadding="false">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/ui_page_inset"
                android:paddingEnd="@dimen/ui_page_inset"
                android:paddingTop="8dp"
                android:paddingBottom="24dp"
                android:saveEnabled="false">
                <TextView
                    android:id="@+id/profileEditNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ui_text_secondary"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="18dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="8dp"
                    android:labelFor="@id/profileEditName"
                    android:text="@string/profile_name"
                    android:textColor="@color/ui_text_secondary"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium.Emphasized" />
                <com.google.android.material.card.MaterialCardView
                    style="@style/HomeVpn.Ui.Panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp">
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/profileNameBox"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:hintEnabled="false"
                            android:layout_marginTop="4dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/profileEditName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="56dp"
                                android:inputType="textCapSentences"
                                android:imeOptions="actionNext"
                                android:maxLines="1"
                                android:maxLength="64"
                                android:hint="@string/profile_name"
                                android:textColor="@color/ui_text_primary"
                                android:textColorHint="@color/ui_text_secondary"
                                android:saveEnabled="false"
                                android:importantForAutofill="no"
                                android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/connection_settings"
                    android:textColor="@color/ui_text_secondary"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium.Emphasized" />
                <com.google.android.material.card.MaterialCardView
                    style="@style/HomeVpn.Ui.Panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:labelFor="@id/profileEditHost"
                            android:text="@string/pref_hostname"
                            android:textColor="@color/ui_text_secondary"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall" />
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/profileHostBox"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:hintEnabled="false"
                            android:layout_marginTop="4dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/profileEditHost"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="56dp"
                                android:inputType="textUri|textNoSuggestions"
                                android:imeOptions="actionNext"
                                android:maxLines="1"
                                android:hint="@string/pref_hostname_hint"
                                android:textColor="@color/ui_text_primary"
                                android:textColorHint="@color/ui_text_secondary"
                                android:saveEnabled="false"
                                android:importantForAutofill="no"
                                android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="12dp"
                            android:layout_marginTop="0dp"
                            android:layout_marginBottom="0dp"
                            android:background="@android:color/transparent" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:labelFor="@id/profileEditPort"
                            android:text="@string/pref_ssl_port"
                            android:textColor="@color/ui_text_secondary"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall" />
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/profilePortBox"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:endIconMode="custom"
                            app:endIconDrawable="@drawable/preference_dropdown_arrow"
                            app:endIconTint="?attr/colorOnSurfaceVariant"
                            app:endIconContentDescription="@string/profile_port_options"
                            app:hintEnabled="false"
                            android:layout_marginTop="4dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/profileEditPort"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="56dp"
                                android:inputType="number"
                                android:imeOptions="actionNext"
                                android:maxLines="1"
                                android:textColor="@color/ui_text_primary"
                                android:textColorHint="@color/ui_text_secondary"
                                android:saveEnabled="false"
                                android:importantForAutofill="no"
                                android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="12dp"
                            android:layout_marginTop="0dp"
                            android:layout_marginBottom="0dp"
                            android:background="@android:color/transparent" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:labelFor="@id/profileEditHub"
                            android:text="@string/pref_hub"
                            android:textColor="@color/ui_text_secondary"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall" />
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/profileHubBox"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:endIconMode="custom"
                            app:endIconDrawable="@drawable/preference_dropdown_arrow"
                            app:endIconTint="?attr/colorOnSurfaceVariant"
                            app:endIconContentDescription="@string/profile_hub_options"
                            app:helperText="@string/profile_hub_manual"
                            app:hintEnabled="false"
                            android:layout_marginTop="4dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/profileEditHub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="56dp"
                                android:inputType="text|textNoSuggestions"
                                android:imeOptions="actionNext"
                                android:maxLines="1"
                                android:textColor="@color/ui_text_primary"
                                android:textColorHint="@color/ui_text_secondary"
                                android:saveEnabled="false"
                                android:importantForAutofill="no"
                                android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/section_authentication"
                    android:textColor="@color/ui_text_secondary"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium.Emphasized" />
                <com.google.android.material.card.MaterialCardView
                    style="@style/HomeVpn.Ui.Panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:labelFor="@id/profileAuthMode"
                            android:text="@string/profile_auth_type"
                            android:textColor="@color/ui_text_secondary"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/profileAuthMode"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="12dp"
                            android:minHeight="48dp"
                            android:gravity="start|center_vertical"
                            app:icon="@drawable/preference_dropdown_arrow"
                            app:iconGravity="end" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:labelFor="@id/profileEditUsername"
                            android:text="@string/pref_username"
                            android:textColor="@color/ui_text_secondary"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall" />
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:hintEnabled="false"
                            android:layout_marginTop="4dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/profileEditUsername"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="56dp"
                                android:inputType="text|textNoSuggestions"
                                android:imeOptions="actionNext"
                                android:maxLines="1"
                                android:textColor="@color/ui_text_primary"
                                android:textColorHint="@color/ui_text_secondary"
                                android:saveEnabled="false"
                                android:importantForAutofill="no"
                                android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <TextView
                            android:id="@+id/profilePasswordLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:labelFor="@id/profileEditPassword"
                            android:text="@string/pref_password"
                            android:textColor="@color/ui_text_secondary"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall" />
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/profilePasswordBox"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:hintEnabled="false"
                            android:layout_marginTop="4dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/profileEditPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="56dp"
                                android:inputType="textPassword|textNoSuggestions"
                                android:imeOptions="actionDone"
                                android:maxLines="1"
                                android:textColor="@color/ui_text_primary"
                                android:textColorHint="@color/ui_text_secondary"
                                android:saveEnabled="false"
                                android:importantForAutofill="no"
                                android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <LinearLayout
                            android:id="@+id/profileClientCertificateFields"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical"
                            android:visibility="gone">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_auth_certificate_hint"
                                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                                android:textColor="@color/ui_text_secondary" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/profileClientCertificateFile"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:minHeight="48dp" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/profileClientPrivateKeyFile"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/profileCertificateCard"
                    style="@style/HomeVpn.Ui.Panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_cert_title"
                            android:textColor="@color/ui_text_primary"
                            android:accessibilityHeading="true"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium.Emphasized" />
                        <TextView
                            android:id="@+id/profileCertificateStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textColor="@color/ui_text_primary"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
                        <TextView
                            android:id="@+id/profileCertificateEndpoint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/ui_text_secondary"
                            android:textIsSelectable="true"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
                        <TextView
                            android:id="@+id/profileCertificateHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/ui_text_secondary"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/profileCertificateManage"
                            style="@style/Widget.Material3Expressive.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:minHeight="56dp"
                            android:singleLine="false"
                            android:text="@string/profile_cert_manage"
                            app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.Medium" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/profile_cert_scope"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/ui_text_secondary"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/profiles_editor_scope"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/ui_text_secondary"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ui_page_inset"
        android:paddingEnd="@dimen/ui_page_inset"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/profileEditSave"
            style="@style/Widget.Material3Expressive.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:singleLine="false"
            android:text="@string/action_save"
            app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.Medium" />
    </LinearLayout>
</LinearLayout>
