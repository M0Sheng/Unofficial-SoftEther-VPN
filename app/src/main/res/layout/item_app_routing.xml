<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.listitem.ListItemCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/HomeVpn.Ui.SelectableListCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:duplicateParentState="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">
        <ImageView
            android:id="@+id/appRoutingIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:duplicateParentState="true"
            android:importantForAccessibility="noHideDescendants"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">
            <TextView
                android:id="@+id/appRoutingLabel"
                style="@style/Widget.Material3.TextView.ListItem.LabelText"
                android:duplicateParentState="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/appRoutingPackage"
                style="@style/Widget.Material3.TextView.ListItem.SupportingText"
                android:duplicateParentState="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="4dp" />
        </LinearLayout>
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/appRoutingSelected"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            style="@style/Widget.Material3.Checkbox.ListItem" />
    </LinearLayout>
</com.google.android.material.listitem.ListItemCardView>