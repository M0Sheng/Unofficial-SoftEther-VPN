<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ui_background">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ui_page_inset"
        android:layout_marginEnd="@dimen/ui_page_inset"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:text="@string/ui_log_description"
        android:textColor="@color/ui_text_secondary"
        android:lineSpacingExtra="2dp"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
    <com.google.android.material.card.MaterialCardView
        style="@style/HomeVpn.Ui.Panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ui_page_inset"
        android:layout_marginEnd="@dimen/ui_page_inset"
        android:layout_marginBottom="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/logCollect"
                style="@style/Widget.Material3.CompoundButton.MaterialSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:minHeight="48dp"
                android:saveEnabled="false"
                android:text="@string/ui_log_collect"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="?attr/colorOnSurface" />
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:hint="@string/ui_log_search"
                app:endIconMode="clear_text">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/logSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:inputType="textFilter"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"
                    android:textColor="@color/ui_text_primary"
                    android:textColorHint="@color/ui_text_secondary"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />
            </com.google.android.material.textfield.TextInputLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/logLevelField"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="@string/ui_log_level">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/logLevel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:minHeight="48dp"
                        android:singleLine="true"
                        android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/logExport"
                    style="@style/Widget.Material3Expressive.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:text="@string/ui_log_export"
                    app:icon="@drawable/ui_ic_export"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="18dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/logClear"
                    style="@style/Widget.Material3Expressive.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:text="@string/ui_log_clear"
                    app:icon="@drawable/ui_ic_clear"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="18dp" />
                <androidx.constraintlayout.helper.widget.Flow
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="logLevelField,logExport,logClear"
                    app:flow_horizontalBias="0"
                    app:flow_horizontalGap="6dp"
                    app:flow_horizontalStyle="packed"
                    app:flow_verticalGap="4dp"
                    app:flow_wrapMode="chain"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:id="@+id/logCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="end"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/ui_text_secondary"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/logList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/ui_page_inset"
            android:paddingEnd="@dimen/ui_page_inset"
            android:paddingBottom="24dp"
            android:clipToPadding="false" />
        <TextView
            android:id="@+id/logEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="32dp"
            android:gravity="center"
            android:text="@string/ui_log_collection_off"
            android:textColor="@color/ui_text_secondary"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
    </FrameLayout>
</LinearLayout>
