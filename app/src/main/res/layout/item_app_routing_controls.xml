<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:focusableInTouchMode="true">
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/appRoutingMode"
        style="@style/HomeVpn.Ui.RoutingModeGroup">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/appRoutingModeBlacklist"
            style="@style/HomeVpn.Ui.AppRoutingMode"
            android:text="@string/app_routing_mode_exclude" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/appRoutingModeWhitelist"
            style="@style/HomeVpn.Ui.AppRoutingMode"
            android:text="@string/app_routing_mode_include" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/appRoutingModeAll"
            style="@style/HomeVpn.Ui.AppRoutingMode"
            android:text="@string/app_routing_mode_all" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
    <TextView
        android:id="@+id/appRoutingModeHint"
        style="@style/HomeVpn.Ui.RoutingModeHint" />
    <TextView
        android:id="@+id/appRoutingSupport"
        style="@style/HomeVpn.Ui.RoutingSupport"
        android:text="@string/app_routing_tun_hint" />
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/app_routing_search"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        app:endIconMode="clear_text">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/appRoutingSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:inputType="textFilter"
            android:imeOptions="actionDone"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:minHeight="56dp" />
    </com.google.android.material.textfield.TextInputLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/appRoutingShowSystem"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:singleLine="false"
            android:layout_height="wrap_content"
            android:text="@string/app_routing_show_system"
            style="@style/Widget.Material3.CompoundButton.MaterialSwitch"
            android:minHeight="56dp"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
        <TextView
            android:id="@+id/appRoutingCount"
            android:accessibilityLiveRegion="polite"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/ui_text_secondary"
            android:paddingStart="8dp"
            android:singleLine="false"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/appRoutingMore"
            style="@style/Widget.Material3Expressive.Button.IconButton.Standard"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/app_routing_actions"
            android:tooltipText="@string/app_routing_actions"
            app:icon="@drawable/profile_ic_more"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />
    </LinearLayout>
    <com.google.android.material.loadingindicator.LoadingIndicator
        android:id="@+id/appRoutingLoading"
        style="@style/Widget.Material3.LoadingIndicator.Contained"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_margin="16dp"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:containerColor="?attr/colorSecondaryContainer"
        app:indicatorColor="?attr/colorOnSecondaryContainer" />
    <TextView
        android:id="@+id/appRoutingEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/app_routing_empty"
        android:textColor="@color/ui_text_secondary"
        android:visibility="gone"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
</LinearLayout>