<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="HomeVpn.Ui.Panel" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
    </style>

    <style name="HomeVpn.Ui.SubpageTitle" parent="TextAppearance.Material3.TitleLarge" />

    <style name="HomeVpn.Ui.SelectableListCard" parent="Widget.Material3.ListItemCardView.Segmented">
        <item name="android:theme">@style/ThemeOverlay.HomeVpn.ListCard</item>
        <item name="android:duplicateParentState">false</item>
        <item name="android:checkable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="swipeEnabled">false</item>
        <item name="contentPadding">0dp</item>
        <item name="contentPaddingTop">0dp</item>
        <item name="contentPaddingBottom">0dp</item>
        <item name="contentPaddingLeft">0dp</item>
        <item name="contentPaddingRight">0dp</item>
    </style>

    <style name="ThemeOverlay.HomeVpn.ListCard" parent="">
        <item name="listItemShapeAppearanceMiddle">@style/ShapeAppearance.Material3.ListItem.Single</item>
    </style>

    <style name="HomeVpn.Ui.RoutingModeGroup" parent="Widget.Material3Expressive.MaterialButtonToggleGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="singleSelection">true</item>
        <item name="selectionRequired">true</item>
    </style>

    <style name="HomeVpn.Ui.RoutingModeHint" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:accessibilityLiveRegion">polite</item>
        <item name="android:textColor">@color/ui_text_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.BodyMedium</item>
    </style>

    <style name="HomeVpn.Ui.RoutingSupport" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/ui_text_secondary</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.BodyMedium</item>
    </style>

    <style name="HomeVpn.Ui.AppRoutingMode" parent="Widget.Material3Expressive.Button.TonalButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:singleLine">false</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>
    <style name="HomeVpn.Ui.Label" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="HomeVpn.Ui.Value" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
</resources>