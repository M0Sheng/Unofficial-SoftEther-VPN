<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Use Android's platform and user-installed trust anchors for TLS preflight. -->
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
